{
  "name": "intern-management-system",
  "version": "1.0.0",
  "description": "Hệ thống quản lý thực tập sinh toàn diện - Internship Management System",
  "type": "module",
  "scripts": {
    "server": "tsx server/index.ts",
    "dev:frontend": "vite",
